# Local / Docker
PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/dbname?sslmode=require
SPRING_DATASOURCE_USERNAME=your_db_user
SPRING_DATASOURCE_PASSWORD=your_db_password

JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
FRONTEND_URL=http://localhost:5173

SPRING_PROFILES_ACTIVE=prod

# --- Vercel (add these in Project Settings → Environment Variables) ---
# Do NOT set PORT on Vercel — it is injected automatically.
#
# Required:
#   SPRING_DATASOURCE_URL
#   SPRING_DATASOURCE_USERNAME
#   SPRING_DATASOURCE_PASSWORD
#   JWT_SECRET
#   FRONTEND_URL=https://your-app.vercel.app
#   COOKIE_SECURE=true
#   SPRING_PROFILES_ACTIVE=prod
#
# Monorepo (same domain): COOKIE_SAME_SITE=Lax
# Split frontend/backend projects: COOKIE_SAME_SITE=None
